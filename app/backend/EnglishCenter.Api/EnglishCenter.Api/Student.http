### Đăng nhập tài khoản student
# @name login
POST http://localhost:5220/api/auth/login
Content-Type: application/json

{
  "email": "student@demo.com",
  "password": "123456"
}

### Lưu token
@token = {{login.response.body.token}}

### Lấy thông tin Dashboard học viên
# Trả về: student (hồ sơ), nextLesson (khóa đang học đầu tiên), courses (khóa đang học theo Enrollment Active),
# notifications (rỗng vì DB chưa có bảng thông báo - xem ghi chú trong DashboardController)
GET http://localhost:5220/api/student/dashboard
Authorization: Bearer {{token}}

### Lấy danh sách khóa học của trung tâm (trang Courses)
# Trả về: mảng khóa học theo type Course trong FE GeneralTypes.ts
# (imageUrl luôn null vì bảng Courses chưa có cột ảnh, FE tự dùng ảnh mặc định)
GET http://localhost:5220/api/student/courses
Authorization: Bearer {{token}}

### Đăng ký khóa học (bấm Register trên thẻ khóa -> lưu thẳng Enrollment vào DB)
# 409 nếu đã đăng ký khóa này rồi, 409 nếu khóa chưa có lớp
POST http://localhost:5220/api/student/courses/5/register
Authorization: Bearer {{token}}

### Lấy danh sách ghi danh của học viên (khối Registered Courses trang Courses)
# Trả về: [{ enrollmentId, status, course }] mới nhất trước
GET http://localhost:5220/api/student/enrollments
Authorization: Bearer {{token}}

### Hủy ghi danh (bấm nút xóa ở khối Registered Courses)
# 409 nếu ghi danh đã có phiếu thu
DELETE http://localhost:5220/api/student/enrollments/17
Authorization: Bearer {{token}}

### Lấy danh sách học phí của học viên (trang Tuition)
# Trả về: [{ enrollmentId, courseName, className, finalTuitionFee, isPaid, paymentId, paidAmount, paidDate, method, note, ... }]
GET http://localhost:5220/api/student/tuition
Authorization: Bearer {{token}}

### Thanh toán học phí (bấm Payment Now) - tạo phiếu thu cho các ghi danh chưa thanh toán
# Method mặc định Cash, PaidDate = hôm nay. 409 nếu các khoản đã chọn đều đã thanh toán
POST http://localhost:5220/api/student/tuition/pay
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "enrollmentIds": [6]
}

